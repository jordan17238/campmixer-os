#!/bin/bash
# campmixer: look after the CampMixer Pi.
set -u

# iw, findmnt and friends live in sbin, which an ordinary user's PATH leaves out.
PATH="$PATH:/usr/local/sbin:/usr/sbin:/sbin"

APP=/opt/campmixer
BOOT=/boot/firmware
NETCONF="$APP/netconf.py"
VERSION="$(cat "$APP/VERSION" 2>/dev/null || echo unknown)"
REPO="https://github.com/jordan17238/campmixer-os"

usage() {
	cat <<'EOF'
campmixer status                        what the Pi is doing right now
campmixer pin                           the PIN the web app asks for
campmixer pin NEW                       change it (4 to 12 digits); every phone has to sign in again
campmixer pin --new                     change it to a made-up one
campmixer pin --force NEW               change it to NEW even if it is one anyone would guess (1234, a year)
campmixer wifi                          Wi-Fi settings in use, with the passwords
campmixer wifi own --name NAME --password PASSWORD [--band 2.4|5] [--channel N]
                                        change the mixer's own Wi-Fi network
campmixer wifi join NAME [PASSWORD]     join this Wi-Fi network whenever it is in range
campmixer wifi forget NAME              stop joining it
campmixer password                      change your login password (card must be unlocked)
campmixer lock                          make the card read-only, so the power can be pulled at any time
campmixer unlock                        make the card writable again, for changes and updates
campmixer update                        put the newest CampMixer OS over this one (unlocked card, internet needed)
campmixer logs                          recent messages from the CampMixer services
campmixer version

Everything except status, logs and version needs sudo.
EOF
}

die() {
	echo "$*" >&2
	exit 1
}

need_root() {
	[ "$(id -u)" -eq 0 ] || die "Run this with sudo."
}

# The one switch is the word overlayroot=tmpfs in cmdline.txt. With it the system runs on a layer in memory
# over a read-only card, and the boot partition is mounted read-only to match (campmixer-bootro does that).
locked_now() { # what is true right now, not what was asked for
	[ "$(findmnt -n -o FSTYPE / 2>/dev/null)" = overlay ]
}

lock_asked_now() {
	grep -q "overlayroot=tmpfs" /proc/cmdline
}

locked_next() {
	grep -q "overlayroot=tmpfs" "$BOOT/cmdline.txt" 2>/dev/null
}

# The boot partition holds the passwords and the PIN, so only root can read it (campmixer-bootro sees to that).
can_read_boot() {
	[ -r "$BOOT/cmdline.txt" ]
}

cmd_status() {
	local model storage dev type state conn stations driver found=0
	model="$(tr -d '\0' </proc/device-tree/model 2>/dev/null || echo "unknown computer")"
	echo "CampMixer OS $VERSION on $(hostname) ($model)"

	if locked_now; then
		storage="locked, safe to pull the power"
		! can_read_boot || locked_next || storage="$storage (unlocks at the next restart)"
	elif lock_asked_now; then
		storage="NOT locked. The read-only layer did not start, so the card is being written to. See: campmixer logs"
	else
		storage="unlocked, changes are kept"
		can_read_boot && locked_next && storage="$storage (locks at the next restart)"
	fi
	echo "Storage:   $storage"

	if command -v nmcli >/dev/null 2>&1; then
		while IFS=: read -r dev type state conn; do
			[ "$type" = wifi ] || continue
			found=1
			# Which radio it is matters: the built-in one sits inside the metal case.
			driver="$(basename "$(readlink -f "/sys/class/net/$dev/device/driver" 2>/dev/null)" 2>/dev/null)"
			case "$driver" in
			brcmfmac) dev="$dev (built-in radio)" ;;
			"") ;;
			*) dev="$dev (USB adaptor, $driver)" ;;
			esac
			case "$state:$conn" in
			unmanaged:*)
				echo "Wi-Fi:     ${dev%% *} is not used"
				;;
			connected:campmixer-ap)
				stations="?"
				command -v iw >/dev/null 2>&1 && stations="$(iw dev "${dev%% *}" station dump 2>/dev/null | grep -c '^Station')"
				echo "Wi-Fi:     own network on $dev, $stations connected"
				;;
			connected:campmixer-join-*)
				echo "Wi-Fi:     joined $(iw dev "${dev%% *}" link 2>/dev/null | sed -n 's/^[[:space:]]*SSID: //p') on $dev"
				;;
			*)
				echo "Wi-Fi:     $dev is $state"
				;;
			esac
		done < <(LC_ALL=C nmcli -t -f DEVICE,TYPE,STATE,CONNECTION device status 2>/dev/null)
	fi
	[ "$found" -eq 1 ] || echo "Wi-Fi:     no radio found"

	echo "Addresses: $(ip -4 -o addr show 2>/dev/null | awk '$2 != "lo" {split($4, a, "/"); printf "%s (%s)  ", a[1], $2}')"

	if systemctl is-active --quiet campmixer-bridge.service; then
		# The bridge tells this Pi itself how it is doing without a sign-in; everyone else has to sign in first.
		curl -s --max-time 2 http://127.0.0.1/api/status 2>/dev/null | python3 -c '
import json, sys
try:
    status = json.load(sys.stdin)
    link = status["link"]
except Exception:
    print("Bridge:    running, but it gave no status report")
    sys.exit()
if not link["open"]:
    print("Bridge:    running, serial port not available (%s)" % link["error"])
elif link["up"]:
    print("Bridge:    running, mixer core connected")
else:
    print("Bridge:    running, no signal from the mixer core")
sign_in = status.get("sign_in", {})
wrong = sign_in.get("wrong_pins", 0)
if not sign_in.get("ready"):
    print("Web app:   NOBODY can sign in: no usable PIN is set. Make one up with: sudo campmixer pin --new")
elif wrong:
    print("Web app:   asks for the PIN. Wrong PINs tried since start-up: %d" % wrong)
else:
    print("Web app:   asks for the PIN. No wrong PINs tried since start-up")
'
	else
		echo "Bridge:    not running. See: campmixer logs"
	fi
}

reload_wifi() { # $1 = own (the mixer's own network changed), join (a network was added) or forget
	systemctl is-active --quiet NetworkManager.service || return 0
	nmcli general reload >/dev/null 2>&1
	nmcli connection reload >/dev/null 2>&1
	echo "Wi-Fi restarts now with the new settings. If you are connected through it, reconnect in about 30 seconds."
	if [ "$1" = own ] && LC_ALL=C nmcli -t -f TYPE,STATE,CONNECTION device status 2>/dev/null | grep -q '^wifi:connected:campmixer-ap$'; then
		# Running its own network right now: start it again with the new name, password or channel.
		nohup nmcli --wait 30 connection up id campmixer-ap >/dev/null 2>&1 &
		return 0
	fi
	# A network was just added: have the radio look for it now rather than when it next gets round to it.
	[ "$1" != join ] || touch /run/campmixer-look-now
	systemctl restart --no-block campmixer-radio.service
}

cmd_wifi() {
	local action="${1:-}" pairs=()
	[ $# -gt 0 ] && shift
	case "$action" in
	"")
		need_root
		python3 "$NETCONF" show --passwords
		;;
	own)
		need_root
		local band="" channel=""
		while [ $# -gt 0 ]; do
			[ $# -ge 2 ] || die "$1 needs a value."
			case "$1" in
			--name) pairs+=("WIFI_NAME=$2") ;;
			--password) pairs+=("WIFI_PASSWORD=$2") ;;
			--band) band="$2" ;;
			--channel) channel="$2" ;;
			*) die "Not an option: $1" ;;
			esac
			shift 2
		done
		# A new band without a channel gets that band's usual channel.
		[ -z "$band" ] || pairs+=("WIFI_BAND=$band" "WIFI_CHANNEL=$channel")
		[ -n "$band" ] || [ -z "$channel" ] || pairs+=("WIFI_CHANNEL=$channel")
		[ "${#pairs[@]}" -gt 0 ] || die "Nothing to change. See: campmixer"
		python3 "$NETCONF" set "${pairs[@]}" || exit $?
		reload_wifi own
		;;
	join)
		need_root
		[ $# -ge 1 ] && [ $# -le 2 ] || die "Use: campmixer wifi join NAME [PASSWORD]"
		python3 "$NETCONF" join "$1" "${2:-}" || exit $?
		reload_wifi join
		;;
	forget)
		need_root
		[ $# -eq 1 ] || die "Use: campmixer wifi forget NAME"
		python3 "$NETCONF" forget "$1" || exit $?
		reload_wifi forget
		;;
	*)
		usage
		exit 2
		;;
	esac
}

cmd_pin() {
	need_root
	[ $# -le 2 ] || die "Use: campmixer pin, campmixer pin NEW, campmixer pin --force NEW or campmixer pin --new"
	python3 "$NETCONF" pin "$@"
}

cmd_lock() {
	need_root
	if locked_now && locked_next; then
		echo "Already locked."
		return 0
	fi
	# The last moment the card can be written: make sure this Pi's own key for the web app is on it,
	# or every phone would have to sign in again after each restart.
	locked_now || python3 "$NETCONF" web-key || true
	if ! dpkg-query -W -f='${Status}' overlayroot 2>/dev/null | grep -q "install ok installed"; then
		apt-get install -y overlayroot || die "Could not install overlayroot. Connect the Pi to the internet and try again."
	fi
	raspi-config nonint enable_overlayfs || die "Could not switch the read-only overlay on."
	locked_next || die "Could not switch the read-only overlay on: cmdline.txt was not changed."
	echo "Locked from the next start. Restart now with: sudo reboot"
}

cmd_unlock() {
	need_root
	if ! locked_now && ! locked_next; then
		echo "Already unlocked."
		return 0
	fi
	raspi-config nonint disable_overlayfs || die "Could not switch the read-only overlay off."
	! locked_next || die "Could not switch the read-only overlay off: cmdline.txt was not changed."
	echo "Unlocked from the next start. Restart now with: sudo reboot"
}

cmd_update() {
	# Puts the newest published CampMixer OS over this one, in place, with the same installer that builds the
	# image. Settings, passwords, the PIN and signed-in phones are kept.
	local again=0 url tag="" newest work installer status
	[ "${1:-}" != "--again" ] || again=1
	need_root
	if locked_now; then
		die "The card is locked, so an update would be gone at the next start. Run 'sudo campmixer unlock', restart, then this again."
	fi
	if [ -n "${CAMPMIXER_UPDATE_URL:-}" ]; then
		url="$CAMPMIXER_UPDATE_URL" # for testing: a copy of the kit from anywhere curl can read
	else
		# Only what has been published under Releases is installed: that is what passed the checks and built.
		tag="$(curl -fsSL -o /dev/null -w '%{url_effective}' --max-time 60 "$REPO/releases/latest" 2>/dev/null)" ||
			die "Could not reach GitHub. This needs a network with internet access: Ethernet, or a Wi-Fi network the mixer has joined."
		tag="${tag##*/}"
		case "$tag" in
		v[0-9]*-build[0-9]*) ;;
		*) die "Could not work out the newest version from GitHub." ;;
		esac
		newest="${tag#v}"
		newest="${newest%-build*}"
		if [ "$newest" = "$VERSION" ] && [ "$again" -eq 0 ]; then
			echo "CampMixer OS $VERSION is the newest. Nothing to do."
			echo "(To install it over itself anyway: sudo campmixer update --again)"
			return 0
		fi
		url="$REPO/archive/refs/tags/$tag.tar.gz"
	fi
	work="$(mktemp -d)" || die "Could not make a folder to work in."
	echo "Fetching ${tag:-the update}..."
	if ! curl -fsSL --max-time 600 "$url" | tar -xz -C "$work"; then
		rm -rf "$work"
		die "Could not fetch the update. Nothing was changed."
	fi
	installer="$(find "$work" -maxdepth 2 -name install.sh | head -n1)"
	if [ -z "$installer" ] || [ ! -f "$(dirname "$installer")/rootfs/opt/campmixer/bridge.py" ]; then
		rm -rf "$work"
		die "What was fetched is not CampMixer OS. Nothing was changed."
	fi
	echo "Installing CampMixer OS $(cat "$(dirname "$installer")/VERSION" 2>/dev/null) over $VERSION"
	bash "$installer"
	status=$?
	rm -rf "$work"
	return "$status"
}

cmd_firststart() {
	# Runs once, on the first start of a freshly written image. That start has to write to the card
	# (it grows the file system, makes the SSH keys and sets the passwords). Every later one must not.
	local flag=/var/lib/campmixer/first-start
	need_root
	[ -e "$flag" ] || return 0
	if locked_now; then
		# Locked, yet still marked as never started: the power went off in the last moment of the first
		# start. Nothing done now would be kept, so go back and finish it properly.
		echo "The first start did not finish. Unlocking and restarting to finish it."
		(cmd_unlock) || die "Could not unlock to finish the first start. See: campmixer logs"
		sync
		systemctl reboot
		return 0
	fi
	timeout 180 systemctl is-system-running --wait >/dev/null 2>&1
	python3 "$APP/firststart.py" || die "First-start set-up failed. It tries again at the next start. See: campmixer logs"
	sync
	# The marker goes only once the card is set to lock, so a failure here is tried again at the next start
	# instead of leaving the card writable for good.
	(cmd_lock) || die "First-start set-up could not lock the card. It tries again at the next start. See: campmixer logs"
	rm -f "$flag"
	sync
	systemctl reboot
}

cmd_password() {
	local user="${SUDO_USER:-}"
	need_root
	[ -n "$user" ] && [ "$user" != root ] || die "Run this with sudo from your own account."
	if locked_now; then
		die "The card is locked, so a new password would be gone at the next start. Run 'sudo campmixer unlock', restart, then this again."
	fi
	passwd "$user" || exit 1
	python3 "$NETCONF" set LOGIN_PASSWORD= >/dev/null
	echo "Password changed. Any copy of the old one in campmixer.txt has been removed."
}

case "${1:-}" in
status)
	cmd_status
	;;
firststart)
	cmd_firststart
	;;
password)
	cmd_password
	;;
wifi)
	shift
	cmd_wifi "$@"
	;;
pin)
	shift
	cmd_pin "$@"
	;;
lock)
	cmd_lock
	;;
unlock)
	cmd_unlock
	;;
update)
	shift
	cmd_update "$@"
	;;
logs)
	journalctl -b --no-pager -n 120 -u campmixer-firststart.service -u campmixer-netconf.service -u campmixer-radio.service -u campmixer-bridge.service
	;;
version)
	echo "CampMixer OS $VERSION"
	;;
*)
	usage
	[ $# -eq 0 ] || exit 2
	;;
esac
