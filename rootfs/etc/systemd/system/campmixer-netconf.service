[Unit]
Description=CampMixer network settings from /boot/firmware/campmixer.txt
Documentation=file:/opt/campmixer/netconf.py
RequiresMountsFor=/boot/firmware
Before=NetworkManager.service
ConditionPathExists=/opt/campmixer/netconf.py

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 /opt/campmixer/netconf.py apply
# A second or two on a Pi 4. The limit only matters if the card is very slow or very busy, as on a first
# start, when the system is also growing its file system and making its SSH keys.
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
